FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server ./server
COPY js/cartas.js js/main.js js/deck-builder.js js/multiplayer.js ./js/

# Verifica as regras e seus arquivos antes de publicar uma imagem incompleta.
RUN node -e 'require("./server/duel-runtime")'

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3000/health >/dev/null || exit 1

CMD ["node", "server/server.js"]
