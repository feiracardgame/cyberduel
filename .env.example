# Copie este arquivo para .env e altere os pesos como quiser.
# Quanto maior o numero, maior a chance relativa. Zero desativa a categoria.
# Exemplo: BAIXA=20 e ALTA=10 faz baixa ter o dobro do peso de alta.
BOOSTER_WEIGHT_BAIXA=20
BOOSTER_WEIGHT_MEDIA=12
BOOSTER_WEIGHT_UTILIDADE=10
BOOSTER_WEIGHT_ALTA=10
BOOSTER_WEIGHT_LENDARIA=4

# Quando sair "utilidade", estes pesos decidem entre efeito e terreno.
BOOSTER_WEIGHT_EFEITO=10
BOOSTER_WEIGHT_TERRENO=10

# Lendarias so entram no sorteio depois desta quantidade de partidas.
BOOSTER_LEGENDARY_MIN_GAMES=0

# Porta publica opcional. O padrao do projeto e 80.
CYBERDUEL_PORT=80

# OAuth do Google: Client ID de uma aplicacao Web (nao precisa de Client Secret).
# Cadastre as origens do frontend no Google Cloud, incluindo a porta local.
# Exemplo: http://localhost:3000 e https://cyberduel.feira-de-jogos.dev.br
GOOGLE_CLIENT_ID=

# Usernames únicos de administradores, separados por vírgula (vazio bloqueia todos).
ADMIN_USERNAMES=
